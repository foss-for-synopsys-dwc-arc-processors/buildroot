# Synopsys nSIM RISC-V 64-bit configuration
BR2_riscv=y
BR2_RISCV_64=y
BR2_RISCV_ABI_LP64D=y

# System configuration
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/qemu/riscv64-virt/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/qemu/riscv64-virt/post-image.sh"

# Linux kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.27"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/synopsys/nsim-riscv64/kernel-fragment.config"
BR2_LINUX_KERNEL_IMAGE=y

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="100M"

# Enable systemd support
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y

# Additional useful packages
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
