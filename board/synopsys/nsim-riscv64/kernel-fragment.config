# nSIM RISC-V kernel configuration fragment
# Disables RISC-V cache management extensions that cause issues in nSIM simulator

# Disable RISC-V cache management extensions that cause issues
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOM is not set

# Enable critical systemd 257.5 kernel requirements
# BPF JIT compilation for modern systemd eBPF features
CONFIG_BPF_JIT=y

# BPF LSM and debug info for RestrictFileSystems= support
CONFIG_BPF_LSM=y
CONFIG_DEBUG_INFO_BTF=y

# Pressure stall information for systemd-oomd
CONFIG_PSI=y

# Built-in EFI variable filesystem (not module)
CONFIG_EFIVAR_FS=y

# DMI SYSFS support for hardware detection
CONFIG_DMI_SYSFS=y